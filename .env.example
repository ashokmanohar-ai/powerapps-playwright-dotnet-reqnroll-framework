# Execution
TEST_ENV=QA
BROWSER=chromium
# Optional: msedge / chrome. Leave blank to use Playwright-managed browser.
BROWSER_CHANNEL=
HEADLESS=true
SLOW_MO_MS=0
TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=60000
TRACE_ENABLED=true
VIDEO_ENABLED=false
ARTIFACTS_PATH=artifacts

# Power Apps
CANVAS_APP_URL=https://apps.powerapps.com/play/e/<environment-id>/a/<app-id>
MODEL_DRIVEN_APP_URL=https://<org>.crm.dynamics.com/main.aspx?appid=<app-id>
# Optional app-specific selector used as an additional readiness signal.
MODEL_DRIVEN_READY_SELECTOR=

# Authentication state - never commit this file
AUTH_STORAGE_STATE_PATH=.playwright-auth/state.json

# Dataverse API
DATAVERSE_BASE_URL=https://<org>.crm.dynamics.com
# Short-lived bearer token. Prefer CI secret injection. Never commit a token.
DATAVERSE_ACCESS_TOKEN=
